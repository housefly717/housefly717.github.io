# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# RESEND_API_KEY: Required for sending verification, welcome, and password reset emails via Resend.
RESEND_API_KEY=""

# USDA_API_KEY: Optional USDA FoodData Central API key for packaged food search.
USDA_API_KEY=""

# ADMIN_PASSWORD: Password for the /admin developer dashboard.
ADMIN_PASSWORD=""

# CONTACT_EMAIL: Developer email address for receiving contact messages and alerts.
CONTACT_EMAIL="housefly@mail2world.com"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server port (defaults to 3000).
PORT="3000"
