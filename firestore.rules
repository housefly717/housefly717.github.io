rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify authenticated user owns the document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper function to verify the single developer account
    function isDev() {
      return request.auth != null && (
        request.auth.uid == 'usr_dev_housefly' ||
        (request.auth.token.email != null && request.auth.token.email == 'housefly@mail2world.com')
      );
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.username is string &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.replyCount == 0;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isDev());
    }

    match /replies/{replyId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.postId is string &&
        request.resource.data.username is string &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500;
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isDev());
    }

    match /users/{userId} {
      allow read, create, update, delete, write: if isOwner(userId);
      allow read, delete: if isDev();

      match /{allSubcollections=**} {
        allow read, create, update, delete, write: if isOwner(userId);
        allow read, delete: if isDev();
      }
    }

    match /profiles/{userId} {
      allow read, create, update, delete, write: if isOwner(userId);
      allow read, delete: if isDev();
    }

    match /diaryEntries/{entryId} {
      allow read, update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isDev());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /waterEntries/{entryId} {
      allow read, update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isDev());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /exerciseEntries/{entryId} {
      allow read, update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isDev());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /weightEntries/{entryId} {
      allow read, update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isDev());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Security events detective log — block all non-dev reads and writes
    match /securityEvents/{eventId} {
      allow read, write: if isDev();
    }
  }
}
